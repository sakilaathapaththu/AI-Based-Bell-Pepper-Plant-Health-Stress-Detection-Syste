rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Each user can only read/write their own uploaded images, under
    // users/{uid}/{category}/{file} (e.g. users/{uid}/thermal_images/...).
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
